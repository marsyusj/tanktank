 dynamicX [48]float64
 dynamicY [48]float64
 dynamicApplied [48]bool
 dynamicActivateAt [48]int
 dynamicDeadline [48]int
 dynamicExpiresAt [48]int
 dynamicDuration [48]int
 dynamicBrickID [48]int
 lootX [32]float64
 lootY [32]float64
 lootUntil [32]int
 nextBrickAt int
 nextWaterAt int
 nextFireAt int
 nextIceAt int
 nextPortalAt int
 lastDynamicTick int = -1
 portalSlotA int = -1
 portalSlotB int = -1
