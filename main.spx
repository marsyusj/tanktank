 forestPlayers int = 1
 forestRoundPlayers int
 forestSpawned int
 forestNextSpawn int
 forestStartTick int
 reversalActive bool
 assaultBaseHP int
 reversalKills [5]int
 reversalKillCount int
 gameMode int
