 dynamicIceCount int
 hudStatus string = "保护基地，消灭敌军"
 mapNotice string

 powerTick int
 bulletLevel int
 shotDamage int
 shotStep float64
 hitDamage int
 baseFortifiedUntil int
 invincibleUntil int
 enemyFrozenUntil int
 enemySlowedUntil int
 chestX float64
