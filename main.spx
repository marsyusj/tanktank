 dropChance int = 40
 pickupName string

	forestX = [48]float64{-192, -168, -144, -120, -72, -48, -24, 0, 24, 48, -192, -168, -144, -120, 120, 144, 168, 192}
	forestY = [48]float64{132, 132, 132, 132, -60, -60, -60, -60, -60, -60, -84, -84, -84, -84, -84, -84, -84, -84}
	mapPoolX [112]float64
	mapPoolY [112]float64

